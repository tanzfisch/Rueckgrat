# uncomment and add your hubs ip here
#HUB_IP=[hub IP]

# models that work with Rückgrat (tested with 24GB vram)
# cognitivecomputations_Dolphin-Mistral-24B-Venice-Edition-Q6_K_L (most reliable)
# Huihui-Qwen3.6-35B-A3B-Claude-4.7-Opus-abliterated-ggml-model-Q3_K
# NousResearch_Hermes-4.3-36B-Q4_K_S
# Huihui-Qwen3.6-27B-abliterated-ggml-model-Q5_K (had issues with json generation, maybe ran out of mem, unclear)
# Huihui-Qwen3.6-27B-abliterated-ggml-model-Q4_K
# dolphin-2.9.1-yi-1.5-34b-Q4_K_M (very fast 24GB a bit too tight)

LLAMA_CPP_MODEL=/models/llm/cognitivecomputations_Dolphin-Mistral-24B-Venice-Edition-Q6_K_L/cognitivecomputations_Dolphin-Mistral-24B-Venice-Edition-Q6_K_L.gguf
LLAMA_CPP_MAX_CONTEXT=4096
LLAMA_CPP_GPU_LAYERS=-1 # -1 means all layers run on GPU
LLAMA_CPP_PORT=8080
LLAMA_CPP_SERVER=rocm # ie. rocm, cuda, intel