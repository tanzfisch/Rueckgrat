QWidget {
    background-color: #121212;
}

QWidget#transparent {
    background: transparent;
}

OneLineBubble {
    border-radius: 16px;
    padding: 10px;
    margin: 0px;
    background-color: #00424c;
    color: white;
}

TextBlock#code {
    border-radius: 16px;
    padding: 16px;
    margin: 0px;
    border: 2px solid #8D8D8D;
    background-color: #262626;
}

TextBlock#text[role="user"] {
    padding: 0px;
    margin: 0px;
    border: none;
    background: transparent;
}

TextBlock#text[role="assistant"] {
    padding: 0px;
    margin: 0px;
    border: none;
    background: transparent;
}

ChatBubble {
    border-radius: 16px;
    font-size: 16px;
}

ChatBubble#chatBubble[role="user"] {
    background-color: #00424c;
}


ChatBubble#chatBubble[role="assistant"] {
    background-color: #343434;
}

ChatBubble#chatBubble[role="error"] {
    background-color: #1E1E1E;
}

ChatBubbleTextEdit#chatBubble {
    background: transparent;
    color: white;
    border: none;
    padding: 0px;    
}

ChatBubbleTextEdit#chatBubble[role="error"] {
    color: #8f0000;
}

QWidget#input_container {
    background-color: #1E1E1E;
    border-radius: 16px;
    padding: 0px;
}

QPushButton#flatButton {
    background-color: transparent;
    border: none;
}

QPushButton {
    background-color: #1E1E1E;
    border: none;
    padding: 10px;
    border-radius: 16px;
    color: #E0E0E0;
}

QPushButton:focus {
    background-color: #2A2A2A;
    outline: none;
    border: none;
}

QPushButton:pressed {
    background-color: #777777;
    outline: none;
    border: none;
}

QPushButton:checked {
    background-color: #00424c;
    outline: none;
    border: none;
}

QTextEdit#contactForm {
    background-color: #1E1E1E;
    border: none;
    border-radius: 16px;
    padding: 10px;
    min-height: 100px;
    color: #E0E0E0;
}

QLineEdit {
    background-color: #1E1E1E;
    border: none;
    border-radius: 16px;
    padding: 10px;
    color: #E0E0E0;
}

QLineEdit#contactForm {
    background-color: #1E1E1E;
    border: none;
    border-radius: 16px;
    padding: 10px;
    color: #E0E0E0;
}

QLineEdit#login {
    background-color: #1E1E1E;
    border: none;
    border-radius: 16px;
    margin: 0px;
    padding: 10px;
    color: gray;
    color: #E0E0E0;
}

QTextEdit#input_box {
    background-color: transparent;
    border: none;
    padding: 0px;
    color: #E0E0E0;
    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif; font-size: 16px; line-height: 1.5;
}

QMenuBar, QMenu {
    background-color: #1E1E1E;
}

QLabel {
    color: #E0E0E0;
    font-size: 16px;
    background-color: transparent;
}

QLabel#label_slider {
    color: #606060;
    font-size: 10px;
    background-color: transparent;
}

QFrame#contact_card {
    border: none;
    border-radius: 16px;
    padding: 10px;
    background-color: #1E1E1E;
}

MessageBox {
    background-color: rgba(0, 0, 0, 150);
}

QWidget#overlay_dialog {
    background: #00424c;
    border-radius: 16px;
}

QListWidget {
    background-color: #1E1E1E;
    color: #e0e0e0;
    border: none;
    border-radius: 16px;
    padding: 2px;
    outline: none;
}

QListWidget::item {
    background-color: #1E1E1E;
    color: #e0e0e0;
    padding: 5px 10px;
}

QScrollBar:vertical {
    background: #2b2b2b;
    width: 4px;
    margin: 0px 0px 0px 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #555555;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #777777;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
}

QScrollBar:horizontal {
    background: #2b2b2b;
    height: 4px;
    margin: 0px 0px 0px 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #555555;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #777777;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    width: 0px;
}

QDoubleSpinBox {
    background-color: #1E1E1E;
    border: none;
    border-radius: 16px;
    padding: 2px;
}

QComboBox {
    background-color: #1e1e1e;
    color: white;
    border: none;
    border-radius: 16px;
    padding: 0px 14px;
    min-height: 40px;
}

QComboBox:focus {
    border: 2px solid #00424c;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
    background: transparent;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #cccccc;
    margin-right: 20px;
}

QComboBox QAbstractItemView {
    background-color: #252525;
    color: white;
    border: 1px solid #333333;
    border-radius: 16px;
    padding: 6px;
    selection-background-color: #00424c;
    selection-color: white;
    outline: none;
}

QComboBox QAbstractItemView::item {
    border-radius: 12px;
    padding: 8px 12px;
    margin: 2px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #00424c;
}

QSlider {
    min-height: 30px;
}

/* groove = slider bar */
QSlider::groove:horizontal {
    height: 30px;
    background: #00424c;
    border-radius: 10px;
}

/* filled portion */
QSlider::sub-page:horizontal {
    background: #0b6b78;
    border-radius: 10px;
}

/* remaining portion */
QSlider::add-page:horizontal {
    background: #1f1f1f;
    border-radius: 10px;
}

/* handle = draggable bubble */
QSlider::handle:horizontal {
    background: #06424a;

    width: 20px;
    height: 20px;

    margin: -4px 0;   /* centers handle vertically */

    border-radius: 16px;
}
