{
    admin 0.0.0.0:2019 {
        origins http://localhost:2019
    }
}

rueckgrat.hub localhost {
    reverse_proxy /ws* http://hub:{$HUB_PORT} {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    tls /etc/caddy/certs/rueckgrat-caddy.cert /etc/caddy/certs/rueckgrat-caddy.key
    reverse_proxy http://hub:{$HUB_PORT}
}
